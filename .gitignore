# Build outputs
*.o
*.d
*.elf
*.bin
*.pdf
/build/
/tests/test_freestanding
__pycache__/
*.pyc

# Local secrets and overrides (.config: see config.example; local.mk: optional make targets)
/.config
/src/config_local.h
/local.mk

# Local-only documentation (intentionally untracked)
/docs/

# Local-only agent configuration (Antigravity and Claude Code)
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/
/.mcp.json

# Local Python environment
/.venv/

# Scripts: only build-relevant generators are tracked
/scripts/*
!/scripts/gen_headers.py
!/scripts/gen_config.py
!/scripts/gen_web.py
