# Test build (REV-33): every module plus the developer tools (do-test, speedtest, soak,
# diagnostic routes). The commit gate runs do-test on this image: make PROFILE=dev
# Same KEY=VALUE format as config.example; the local .config overrides any key here.

# Modules linked into the image (src/modules/<name>/); the core is always there.
MODULES=light mqtt ieee802154 dev

# do-test needs about 19 KB of main stack (REV-32); keep the old 32 KB minimum.
MAIN_STACK_MIN=32768

# Fixed-size block pools (src/arena.c) for do-test and soak: 32 x 64 B and 16 x 256 B.
POOL_SMALL_BLOCKS=32
POOL_MEDIUM_BLOCKS=16
