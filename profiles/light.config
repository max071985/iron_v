# Production image for a light (REV-33): the onboard RGB LED with its page at / and REST v1
# (/api/v1/light, /api/v1/device). No MQTT, no developer tools. `make` builds this profile.
# Same KEY=VALUE format as config.example; the local .config overrides any key here.

# Modules linked into the image (src/modules/<name>/); the core is always there.
MODULES=light

# Link-time minimum for the main stack in bytes (the stack is the DRAM left above .bss).
# Measured peak in production use: 2.5 KB (REV-32); the packet path runs on the Wi-Fi task stack.
MAIN_STACK_MIN=8192

# Fixed-size block pools (src/arena.c): only the developer tools use them.
POOL_SMALL_BLOCKS=0
POOL_MEDIUM_BLOCKS=0
